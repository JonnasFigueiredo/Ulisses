# Copie para .env e ajuste antes de qualquer uso em producao: cp .env.example .env
#
# Gere segredos fortes, por exemplo:
#   openssl rand -hex 32

# Segredo de assinatura dos tokens JWT (obrigatorio no perfil prod).
ULISSES_JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Chave para criptografar os templates biometricos em repouso (AES-256-GCM, obrigatoria no prod).
# ATENCAO: trocar esta chave depois torna ilegiveis os templates ja cadastrados.
ULISSES_CRYPTO_KEY=troque-esta-chave-de-criptografia

# Origens permitidas pelo CORS (separadas por virgula). Restrinja ao seu frontend/app.
ULISSES_CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
